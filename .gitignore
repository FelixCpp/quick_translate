# Alle Patterns hier greifen auf jeder Ebene (also auch in packages/<app>/),
# da Git Patterns ohne Slash tiefenunabhaengig matcht.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code enthaelt Launch-Configs, die man ggf. committen will:
#.vscode/

# Flutter/Dart/Pub related
